# Discord bot secrets (do not share)

# 1) DISCORD_TOKEN
#    Discord Developer Portal → Your App → Bot → Reset/Copy Token
#    https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# 2) CLIENT_ID
#    Developer Portal → Your App → General Information → Application ID
CLIENT_ID=your_application_client_id_here

# 3) GUILD_ID (recommended)
#    Discord → User Settings → Advanced → Developer Mode ON
#    Then right-click your server icon → Copy Server ID
#    Makes slash commands appear instantly in that server
GUILD_ID=your_discord_server_id_here
